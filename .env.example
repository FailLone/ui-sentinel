# Copy to .env. Use models/providers explicitly chosen for this project.
PORT=4111
ARENA_PORT=4173
ARENA_API_PORT=4174
ARENA_CONTROL_PORT=4175
# Private evaluator credential. Set a random local value; never provide it to the tested Agent.
ARENA_CONTROL_TOKEN=
EXPORT_ARENA_PORT=4183
EXPORT_API_PORT=4184
EXPORT_CONTROL_PORT=4185
EXPORT_CONTROL_TOKEN=
DATABASE_URL=file:./data/ui-sentinel.db
# Main model: openai/<model>, anthropic/<model>, or google/<model>
AGENT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Midscene vision model (provider-compatible model name, not necessarily provider/name)
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL_FAMILY=
RUN_TOTAL_TIMEOUT_MS=300000
RUN_MAX_ACTIONS=40
RUN_MAX_MODEL_CALLS=30
TOOL_TIMEOUT_MS=15000

# Used by isolated validation and the optional Jev blocker review. Main/vision model config stays explicit.
OPENROUTER_API_KEY=
# Model response deadline (tool execution has its own deadline); retries are 0 or 1.
MODEL_REQUEST_TIMEOUT_MS=60000
MODEL_REQUEST_MAX_RETRIES=1

# Set 0 to disable validated implicit pre-action observation reuse.
EXECUTION_OBSERVATION_REUSE=1

# Set 0 to restore all-rule evaluation/context without dependency caching.
EXECUTION_RULE_ROUTING=1

# Set 0 to disable reuse of evidenced read-only navigation segments.
EXECUTION_JOURNEYS=1

# Validated bounded investigation tool, enabled by default; 0 restores the separate tools.
EXECUTION_ATOMIC_INVESTIGATION=1

# Optional evidence-gated blocker finish review. Full exploration remains with the main Agent.
# Uses OpenRouter Decisions API; requires this key or OPENROUTER_API_KEY.
# Freeze checked model snapshot; errors/unknown/changed state return to the full Agent.
EXECUTION_BLOCKER_REVIEW=0
# COMPLETION_REVIEW_API_KEY=<OpenRouter key, or omit to use OPENROUTER_API_KEY>
