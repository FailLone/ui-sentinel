# === Model Configuration ===
# Main agent model (provider/model format for Mastra)
AGENT_MODEL=anthropic/claude-sonnet-4-6
# Vision model for Midscene.js
VISION_MODEL=anthropic/claude-sonnet-4-6

# Provider API keys (set the one matching your chosen provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Midscene.js model config (maps from VISION_MODEL at startup)
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_FAMILY=

# === Server ===
PORT=4111
ARENA_PORT=4173

# === Storage ===
DATABASE_URL=file:./data/ui-sentinel.db

# === Run Budgets (defaults, can override per-run) ===
RUN_TOTAL_TIMEOUT_MS=300000
RUN_MAX_ACTIONS=40
RUN_MAX_MODEL_CALLS=30
TOOL_TIMEOUT_MS=15000
