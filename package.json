{
  "name": "ui-sentinel",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "pnpm typecheck && tsx scripts/build.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "arena:reset": "tsx scripts/cli/arena-reset.ts",
    "smoke:model": "tsx scripts/cli/smoke-model.ts",
    "evaluate": "tsx scripts/cli/evaluate.ts",
    "report": "tsx scripts/cli/report.ts",
    "build:web": "vite build --config src/web/vite.config.ts",
    "arena:start": "ARENA_STATIC=1 node dist/arena/index.js",
    "test:fixtures": "tsx scripts/verify-fixtures.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "validate:acceptance": "tsx scripts/validation/acceptance.ts",
    "validate:learning": "tsx scripts/validation/learning.ts",
    "validate:persistence": "tsx scripts/validation/persistence.ts",
    "validate:investigation": "tsx scripts/validation/investigation.ts",
    "validate:blocker-review": "tsx scripts/validation/investigation.ts --blocker-review",
    "arena:export:start": "EXPORT_ARENA_STATIC=1 node dist/arena-export/index.js",
    "test:fixtures:export": "tsx scripts/verify-export-fixtures.ts",
    "validate:business": "tsx scripts/validation/business.ts",
    "fixture:approved-retry": "tsx scripts/validation/approved-retry.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.72",
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.67.0",
    "@midscene/web": "^1.13.0",
    "dotenv": "^18.0.1",
    "hono": "^4.13.8",
    "playwright": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.17.1"
}
